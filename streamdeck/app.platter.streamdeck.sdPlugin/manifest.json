{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "Name": "Platter",
  "Version": "0.3.0.0",
  "Author": "Platter",
  "Description": "Control Platter, the music player for your library: the cover on a key, playback, modes, volume, likes and ratings, playlists, mixes, the queue, Listen on, the sleep timer and more, on keys, dials and the Neo info bar.",
  "URL": "https://github.com/Silvercyclops999/platter",
  "Icon": "imgs/plugin/icon",
  "Category": "Platter",
  "CategoryIcon": "imgs/plugin/category",
  "CodePath": "bin/plugin.js",
  "PropertyInspectorPath": "ui/pair.html",
  "UUID": "app.platter.streamdeck",
  "SDKVersion": 2,
  "Software": {
    "MinimumVersion": "7.6"
  },
  "Nodejs": {
    "Version": "20"
  },
  "OS": [
    {
      "Platform": "mac",
      "MinimumVersion": "13"
    },
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "Actions": [
    {
      "UUID": "app.platter.streamdeck.playpause",
      "Name": "Play / Pause",
      "Tooltip": "Plays or pauses, with the cover on the key. Press twice for next, three times or hold for previous.",
      "Icon": "imgs/actions/play",
      "Controllers": [
        "Keypad"
      ],
      "PropertyInspectorPath": "ui/action.html",
      "States": [
        {
          "Image": "imgs/keys/play"
        }
      ]
    },
    {
      "UUID": "app.platter.streamdeck.previous",
      "Name": "Previous",
