# For development only. Copy this to .env (which is gitignored) so you can test
# against your real server while working on the app. The app itself signs in
# with Plex and keeps the token in the OS keychain.

# Plex token: in Plex Web open any song, then ... > Get Info > View XML, and
# copy the value after X-Plex-Token= in the address bar.
PLEX_TOKEN=

# Optional. If you leave it blank, the app asks Plex for your server's addresses
# and connects directly (home network first, Plex remote access when away).
# Only set it to force one address while testing, e.g. http://192.168.1.50:32400
PLEX_URL=
